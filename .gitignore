analysis/docking/**/*.pdb
analysis/afold/**/*.cif
analysis/afold/**/*.pdb
analysis/afold/**/*.zip

# Alignments can get large; keep curated ones by force-adding
analysis/conservation/*.a3m
analysis/conservation/*.sto

# Python
